# Public URL of the app (used for OAuth redirect and wallet-link message domain)
APP_URL=http://localhost:3000
# Random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Optional: 32-byte base64 key for encrypting stored GitHub tokens (AES-256-GCM).
# If unset, a key is derived from SESSION_SECRET. Changing it signs everyone out of GitHub API access.
# TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Callback URL: $APP_URL/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: token for GitHub API calls when no user token is available (higher rate limit)
# GITHUB_TOKEN=

# Comma-separated GitHub logins allowed to create events and cross-event opportunities
ADMIN_GITHUB_LOGINS=

# Database: unset = embedded PGlite under .data/pglite; or a Postgres URL
# DATABASE_URL=postgres://user:pass@localhost:5432/buidl

# Solana: devnet or localnet only (mainnet is refused by design)
SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=https://api.devnet.solana.com
# Issuer keypair, solana-keygen JSON byte array. Create with `npm run issuer:keygen`.
ISSUER_SECRET_KEY=
# For verification-only deployments: the issuer public key to trust
# ISSUER_AUTHORITY=
# SAS_CREDENTIAL_NAME=buidl-identity
# SAS_SCHEMA_NAME=buidl-contribution
# SAS_SCHEMA_VERSION=1
